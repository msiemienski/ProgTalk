# Root local Docker development environment
# Usage:
# 1) Copy this file to .env in the project root
# 2) Run: docker compose up --build

# ---------------------------
# MongoDB (used by docker-compose.yml)
# ---------------------------
MONGODB_USER=progtalk_user
MONGODB_PASSWORD=progtalk_password

# ---------------------------
# Backend auth secrets
# ---------------------------
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ---------------------------
# Local runtime behavior
# ---------------------------
NODE_ENV=development
PORT=3000

# Keep HTTP by default for reliable first-run local setup.
# Set to true only when certs/server.key and certs/server.cert exist.
ENABLE_HTTPS=false

# Used by backend CORS and URL normalization logic.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://localhost:5173

# Optional when ENABLE_HTTPS=true
SSL_KEY_PATH=/app/certs/server.key
SSL_CERT_PATH=/app/certs/server.cert
