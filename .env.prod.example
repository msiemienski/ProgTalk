# Public domain where the app will be available
FRONTEND_URL=https://your-domain.example
DOMAIN=your-domain.example
LETSENCRYPT_EMAIL=you@example.com

# Explicit CORS allowlist for production (comma separated)
CORS_ALLOWED_ORIGINS=https://your-domain.example

# MongoDB settings
MONGODB_USER=progtalk_user
MONGODB_PASSWORD=change-me
MONGODB_URI=mongodb://progtalk_user:change-me@mongo:27017/progtalk?authSource=admin

# JWT secrets
JWT_SECRET=replace-with-long-random-secret
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
