# Standalone backend local environment (backend folder run).
# Not used by root docker compose and not used by Render if using Docker service env vars.

# Server Configuration
NODE_ENV=development
PORT=3000
HTTPS_PORT=3000
ENABLE_HTTPS=true

# MongoDB Configuration
MONGODB_URI=mongodb://progtalk_user:progtalk_password@localhost:27017/progtalk?authSource=admin
MONGODB_USER=progtalk_user
MONGODB_PASSWORD=progtalk_password

# SSL Certificates (for development)
SSL_KEY_PATH=../certs/server.key
SSL_CERT_PATH=../certs/server.cert

# CORS
FRONTEND_URL=https://localhost:5173
CORS_ALLOWED_ORIGINS=https://localhost:5173

# JWT (for future use)
JWT_SECRET=replace-with-long-random-secret
JWT_ACCESS_SECRET=your-access-token-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d