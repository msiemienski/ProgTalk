# Render single-service deployment environment
# Set these in Render Dashboard -> Service -> Environment

NODE_ENV=production
ENABLE_HTTPS=false

# Set to your Render URL first, then custom domain later if attached
FRONTEND_URL=https://your-service-name.onrender.com
# Comma-separated origins, no trailing slash
# Example with custom domain:
# CORS_ALLOWED_ORIGINS=https://your-service-name.onrender.com,https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-service-name.onrender.com

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster-name.mongodb.net/progtalk?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-long-random-secret
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
